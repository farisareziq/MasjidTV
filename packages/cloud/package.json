{
  "name": "@masjidtv/cloud",
  "version": "1.1.3",
  "type": "module",
  "description": "MasjidTV cloud multi-tenant Fastify app (Vercel + Turso + Blob)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node scripts/gen-pages.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/gen-pages.mjs && tsc -p tsconfig.json --noEmit",
    "vercel-build": "node scripts/build.mjs",
    "build:vps": "node scripts/build-vps.mjs",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@masjidtv/db": "workspace:*",
    "@masjidtv/shared": "workspace:*",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
