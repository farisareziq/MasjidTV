# MasjidTV cloud environment (Vercel)
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=eyJ...
JWT_SECRET=change-me-long-random-string
LICENSE_PUBLIC_KEY=MCowBQYDK2VwAyEA...
VERCEL_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Recommended: public base URL of this deployment (no trailing slash).
# Used to build the TV "screenUrl" shown in web admin. Without it, the URL is
# derived from the incoming request's Host header — which breaks if admin is
# opened via a preview deployment or custom domain (TV keys itself to a
# throwaway URL). Set to the stable production alias.
# MASJIDTV_PUBLIC_URL=https://masjidtv.vercel.app

# Optional: map mosque display domains -> tenant API keys
# DISPLAY_DOMAIN_KEYS={"tv.masjidcontoh.com":"<tenant-api-key>"}

# Optional (C4): Sentry/GlitchTip DSN for 5xx error reporting.
# Without it, error reporting is a complete no-op (zero overhead).
# Format: https://<publicKey>@<host>/<projectId>
# SENTRY_DSN=https://abc123@glitchtip.example.com/1
