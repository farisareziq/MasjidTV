{
  "version": 2,
  "framework": null,
  "buildCommand": "pnpm run vercel-build",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/display", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/guide", "destination": "/api/index" },
    { "source": "/super", "destination": "/api/index" },
    { "source": "/sw.js", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store" }]
    }
  ]
}
