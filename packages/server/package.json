{
  "name": "@masjidtv/server",
  "version": "1.1.1",
  "type": "module",
  "description": "MasjidTV local Fastify server (offline-first, full parity with TVMasjid)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@masjidtv/db": "workspace:*",
    "@masjidtv/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.38.4",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
