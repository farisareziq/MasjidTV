{
  "name": "@masjidtv/kiosk",
  "version": "1.1.0",
  "private": true,
  "description": "MasjidTV kiosk mini-PC app (Electron): embedded server + fullscreen kiosk display",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node tools/dev.mjs",
    "start": "electron .",
    "package": "node tools/package.mjs",
    "test": "echo \"kiosk tests run from repo root (vitest workspace)\" && exit 0"
  },
  "dependencies": {
    "@masjidtv/server": "workspace:*"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2"
  }
}
