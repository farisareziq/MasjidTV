# MasjidTV local server
PORT=3000
# MASJIDTV_DATA_DIR overrides the default %APPDATA%\MasjidTV data directory
# MASJIDTV_DATA_DIR=C:\ProgramData\MasjidTV

# Cloud-sync mode (mini PC as cache-proxy of the cloud tenant).
# When both are set, local admin is disabled and /api/settings|today|slides
# are proxied+cached from the cloud.
# CLOUD_URL=https://your-app.vercel.app
# TENANT_KEY=<tenant-api-key>

# Kiosk crash reporting (C4): local rotating log at <dataDir>/logs/crash-*.log
# is ALWAYS on. Upload to cloud is opt-in — set to 1 to POST new crash
# entries with the device heartbeat (requires pairing).
# MASJIDTV_CRASH_UPLOAD=1
