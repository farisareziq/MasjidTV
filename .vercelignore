# Vercel CLI deploys scan the whole repo. Patterns here are anchored to the
# repo root (leading "/") so e.g. "/scripts" never matches
# packages/cloud/scripts.
/release
/dist
/coverage
/.github
/.vite
/logs
/data
/cloud-data
/node_modules
/apps
/scripts
/tools
/packages/frontend
/packages/server
/packages/cloud/node_modules
/packages/cloud/dist
/packages/cloud/.vercel
/packages/cloud/.env*
/packages/shared/node_modules
/packages/shared/dist
/packages/db/node_modules
/packages/db/dist
/packages/db/data
*.log
*.zip
