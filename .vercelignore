# Vercel CLI deploys scan the whole repo. Patterns here are anchored to the
# repo root (leading "/") so e.g. "/scripts" never matches
# packages/cloud/scripts.
# NOTE: /packages/frontend/public is REQUIRED — gen-pages.mjs embeds it at
# build time. node_modules are installed by Vercel's pnpm install.
/release
/dist
/coverage
/.github
/.vite
/logs
/data
/cloud-data
/node_modules
/apps
/scripts
/tools
/packages/frontend/node_modules
/packages/server
/packages/cloud/node_modules
/packages/cloud/dist
/packages/cloud/.vercel
/packages/cloud/.env*
/packages/cloud/src/pages.generated.ts
/packages/shared/node_modules
/packages/shared/dist
/packages/db/node_modules
/packages/db/dist
/packages/db/data
*.log
*.zip
